---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 mb-6 space-y-4"
    aria-label="Filter games"
    data-testid="game-filters"
    data-game-filters
>
    <fieldset class="min-w-0">
        <legend class="text-sm font-medium text-slate-300 mb-2">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-sm text-slate-200 bg-slate-700/50 rounded-lg px-3 py-2 cursor-pointer hover:bg-slate-700 transition-colors">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-col sm:flex-row sm:items-end gap-4">
        <div class="flex flex-col gap-2 sm:w-64">
            <label for="publisher-filter" class="text-sm font-medium text-slate-300">Publisher</label>
            <select
                id="publisher-filter"
                name="publisher"
                class="rounded-lg bg-slate-700 text-slate-100 border border-slate-600 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="button"
            class="rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 px-4 py-2 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
            data-filter-clear
        >
            Clear filters
        </button>
    </div>

    <p class="text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-count" data-filter-count></p>
</form>
